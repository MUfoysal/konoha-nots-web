{
  "name": "konoha-notes",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-konoha-notes --only firestore \"node --test tests/rules/*.test.js\"",
    "emulators": "firebase emulators:start --project demo-konoha-notes --only auth,firestore,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
